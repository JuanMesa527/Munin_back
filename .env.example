# ============================================================================
#  perfilador-vivienda-backend — variables de entorno
# ============================================================================
#  Copia este archivo a `.env` y llena los valores.
#  REGLA 20: NUNCA comitear `.env` ni hardcodear secretos. `.env` esta en
#  .gitignore. Si filtras una llave, rotala antes de seguir.
# ============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Origenes permitidos por CORS, separados por coma. En produccion NUNCA "*".
CORS_ORIGINS=http://localhost:5173

# Limitadores de peticiones (el 429 "Demasiadas solicitudes"). Vacio = el
# default por entorno: apagados fuera de produccion, encendidos en produccion.
# `false` los apaga incluso en produccion — solo para una demo controlada.
RATE_LIMIT_ENABLED=

# Si pedir un OTP responde la causa real ("no existe una cuenta con ese
# contacto", o el fallo del envio) en vez de un `enviado: true` a ciegas.
# Vacio = encendido solo fuera de produccion.
# `true` en produccion es una decision consciente: hace el endpoint enumerable
# (OWASP A07) a cambio de poder explicar por que no llega un codigo en la demo.
OTP_REVEAL_CAUSE=

# Saltos de proxy en los que confiar para leer `X-Forwarded-For`.
#   0 = local / sin proxy (default).
#   1 = detras de Vercel u otro PaaS con un solo proxy delante. Sin esto todos
#       los usuarios comparten `req.ip` y el rate limiter los mete en el mismo
#       balde: el primer curioso deja al resto en 429.
TRUST_PROXY=0

# ---------------------------------------------------------------------------
#  LLM — detras de LlmPort. Solo parsea texto libre y redacta el "por que".
#  NUNCA toma la decision de scoring/enrutamiento (regla 12, glass-box).
#  Deja LLM_PROVIDER=stub para trabajar sin llave y sin gastar tokens.
# ---------------------------------------------------------------------------
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
#  Auth del closer (F3/F4). El token va en cookie httpOnly + SameSite=Strict.
#  Genera el secreto con: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# ---------------------------------------------------------------------------
CLOSER_SESSION_SECRET=cambiame-en-local-y-nunca-lo-comitees
CLOSER_SESSION_TTL_MINUTES=480
CLOSER_USERNAME=closer.demo
CLOSER_PASSWORD=cambiame-closer

# ---------------------------------------------------------------------------
#  Login por OTP del lead (F2.2). Mucho mas largo que el del closer: un lead
#  vuelve a nutrirse a lo largo de dias/semanas, no en un turno de trabajo.
# ---------------------------------------------------------------------------
LEAD_SESSION_TTL_MINUTES=43200

# ---------------------------------------------------------------------------
#  Persistencia.
#   memory   = adapter in-memory (default del scaffolding, sin base de datos).
#   supabase = persiste catalogo, swipes y telemetria de F2.1 en Supabase.
#              Exige SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (abajo).
#  No apuntar a ninguna base de datos de produccion de Colsubsidio.
# ---------------------------------------------------------------------------
PERSISTENCE_DRIVER=memory

# ---------------------------------------------------------------------------
#  Supabase (solo si PERSISTENCE_DRIVER=supabase).
#  El SERVICE_ROLE_KEY ignora RLS: vive SOLO en el backend, JAMAS en el front
#  (todo VITE_* es publico). Aplica antes el schema: supabase/migrations/.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
#  Datos calibrados (salida del pipeline offline de analysis/)
# ---------------------------------------------------------------------------
WEIGHTS_PATH=./data/weights.json
PROJECT_PROFILES_PATH=./data/project_profiles.json
PROJECTS_CATALOG_PATH=./data/projects_catalog.json

# ---------------------------------------------------------------------------
#  Tratamiento de datos (Ley 1581 de 2012)
#  Version del aviso de privacidad que el usuario acepta. Subirla cada vez que
#  cambie el texto: queda registrada en ConsentRecord.versionPolitica.
# ---------------------------------------------------------------------------
PRIVACY_POLICY_VERSION=2026-07-24.v1
# ---------------------------------------------------------------------------
#  Supabase (persistencia de LeadProfile — F1). Nunca la anon key aqui: el
#  backend necesita bypass de RLS via service_role. Migraciones en
#  supabase/migrations/.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://objidszmsrxszrzvtmtx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
#  DeepSeek (detras de LlmPort, mismas reglas que la seccion LLM de arriba).
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
#  F5 · call-simulation — entrenador de cierre por voz (adenda A11).
#  Puerto propio (CallSimulatorPort), NO es LlmPort: el roleplay interpreta a
#  la persona, nunca decide el veredicto (regla 12, glass-box). Usa la MISMA
#  DEEPSEEK_API_KEY de arriba.
#    CALL_SIM_PROVIDER=stub     -> respuestas guionadas, sin red, sin costo.
#    CALL_SIM_PROVIDER=deepseek -> roleplay real. Exige DEEPSEEK_API_KEY.
# ---------------------------------------------------------------------------
CALL_SIM_PROVIDER=stub

# ---------------------------------------------------------------------------
#  Voz del lead simulado (Amazon Polly). SPEECH_PROVIDER=none deja
#  CallTurn.audio en null y la UI cae a solo texto: nunca rompe la demo.
#  Credenciales AWS por la cadena por defecto del SDK (perfil del `aws` CLI,
#  variables de entorno o rol de instancia) — NUNCA hardcodeadas aqui.
#  No existe voz es-CO: se usa es-MX (Mia/Andres), el acento neutro mas
#  cercano. engine=generative es el mas natural; cae a neural si Polly la
#  rechaza para la cuenta.
# ---------------------------------------------------------------------------
SPEECH_PROVIDER=none
AWS_REGION=us-east-1
POLLY_ENGINE=generative
POLLY_VOICE_FEMALE=Mia
POLLY_VOICE_MALE=Andres

#  Dictado del closer (adenda A12). La Web Speech API del navegador solo
#  funciona de verdad en Chrome, asi que la transcripcion la hacemos nosotros.
#  `aws` = Amazon Transcribe Streaming, MISMA cuenta y credenciales que Polly.
#  `none` = dictado apagado, el closer escribe (la llamada nunca se bloquea).
TRANSCRIPTION_PROVIDER=none